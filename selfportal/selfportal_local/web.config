<?xml version="1.0" encoding="utf-8"?>
<!--
    web.config для SelfPortal (смена пароля локального пользователя Windows)

    Содержит:
      - Заголовки безопасности (HSTS, X-Frame-Options, CSP, nosniff, Referrer-Policy)
      - Скрытие версии ASP.NET (enableVersionHeader)
      - Secure + HttpOnly cookie сессии
      - customErrors (RemoteOnly) — без утечки стек-трейса
      - Ограничение размера запроса (защита от DoS)

    ВАЖНО:
      - Секция <system.webServer> требует IIS 7+ (Integrated pipeline).
      - Для HSTS убедитесь, что сайт доступен ТОЛЬКО по HTTPS.
      - Если перед IIS стоит reverse proxy, добавьте его IP в allowlist
        и настройте передачу реального IP (но код намеренно не доверяет
        X-Forwarded-For без proxy).
-->

<configuration>

  <system.web>

    <!-- Скрыть заголовок X-AspNet-Version -->
    <httpRuntime
        enableVersionHeader="false"
        maxRequestLength="4096"
        requestValidationMode="4.5"
    />

    <!-- Cookie: HttpOnly + Secure + SameSite -->
    <httpCookies
        httpOnlyCookies="true"
        requireSSL="true"
        sameSite="Lax"
    />

    <!-- Не отдавать стек-трейс удалённым клиентам -->
    <customErrors
        mode="RemoteOnly"
        defaultRedirect="/error.htm"
    />

    <!-- Запрет трассировки -->
    <trace
        enabled="false"
        localOnly="true"
    />

    <!-- Ограничение ViewState (MAC уже включён в странице) -->
    <pages
        enableViewStateMac="true"
        viewStateEncryptionMode="Always"
    />

  </system.web>

  <system.webServer>

    <!-- Документ по умолчанию: без него IIS отдаёт 403 на /SelfPortal/ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="password.aspx" />
      </files>
    </defaultDocument>

    <!-- Заголовки безопасности -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />

        <!-- HSTS: включить только когда сайт гарантированно работает по HTTPS -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <!-- CSP: разрешаем только собственный контент; data: нужен для CAPTCHA (base64) -->
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- Скрыть заголовок Server (IIS 10+) -->
    <security>
      <requestFiltering
          removeServerHeader="true"
      >
        <requestLimits
            maxAllowedContentLength="1048576"
        />
      </requestFiltering>
    </security>

    <!-- Запрет доступа к чувствительным каталогам -->
    <httpErrors errorMode="DetailedLocalOnly" />

  </system.webServer>

</configuration>
